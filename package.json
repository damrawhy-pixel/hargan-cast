{
  "name": "hargan-cast",
  "productName": "Hargan Cast",
  "version": "0.2.0",
  "private": true,
  "description": "Hargan Cast",
  "license": "AGPL-3.0-only",
  "author": "Hargan Cast",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "native": "node scripts/build-native.mjs",
    "dist": "electron-vite build && electron-builder --win dir"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "ip-address": "^9.0.5",
    "jose": "^5.1.0",
    "uuid-1345": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "events": "^3.3.0",
    "rcedit": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "xstreaming-player": "0.3.4"
  },
  "build": {
    "appId": "app.hargan.cast",
    "productName": "Hargan Cast",
    "copyright": "© 2026 Hargan Cast",
    "directories": { "output": "dist" },
    "files": ["out/**"],
    "extraResources": [{ "from": "native/bin/hargan-ps-core.exe", "to": "hargan-ps-core.exe" }, { "from": "LICENSE", "to": "LICENSE" }, { "from": "NOTICE.md", "to": "NOTICE.md" }],
    "afterPack": "scripts/after-pack.cjs",
    "win": { "target": "dir", "signAndEditExecutable": false }
  }
}
