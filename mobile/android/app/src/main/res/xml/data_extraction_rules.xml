<?xml version="1.0" encoding="utf-8"?>
<!-- Account sessions (Sony NPSSO, Xbox tokens) live in the app's web storage.
     None of it may leave the phone in a cloud backup or a device-to-device move:
     a new phone signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
