<?xml version="1.0" encoding="utf-8"?>
<!-- The Android TV launcher's 16:9 tile: the app icon on the app's dark ground. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0D12" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="180dp" android:height="180dp">
        <bitmap android:src="@mipmap/ic_launcher_foreground" android:gravity="center" />
    </item>
</layer-list>
